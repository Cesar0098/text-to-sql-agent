# Copiá este archivo a .env y completá los valores.
# config.py lo carga solo (con python-dotenv) al importar agent_core.

# Requerida: tu API key de Anthropic, para que el agente pueda generar
# SQL y las interpretaciones de negocio.
ANTHROPIC_API_KEY=

# Opcional. Connection string de SQLAlchemy a tu base de datos.
# Si la dejás vacía (o no la definís), se usa la base SQLite de demo
# que genera data_generation/generate_db.py (empresa_b2b.db).
#
# Ejemplos:
#   DATABASE_URL=sqlite:///empresa_b2b.db
#   DATABASE_URL=postgresql://usuario:password@host:5432/tu_base
#   DATABASE_URL=mysql+pymysql://usuario:password@host:3306/tu_base
#
# Para Postgres o MySQL, usá un usuario con permisos de solo SELECT
# (ver la sección de seguridad en README.md) — no las credenciales de
# administrador de la base.
DATABASE_URL=
